# =============================================
# DAYBYDAY FRONTEND - ENVIRONMENT VARIABLES
# =============================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# -----------------------------------------------
# STRAPI BACKEND URL
# -----------------------------------------------
# For local development:
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# For production (your Render.com URL):
# NEXT_PUBLIC_STRAPI_URL=https://your-app-name.onrender.com

# -----------------------------------------------
# DEPLOYMENT (Vercel — Free)
# -----------------------------------------------
# How to deploy the frontend:
#   1. Go to https://vercel.com and sign up with GitHub (free)
#   2. Click "Add New Project" → Import your GitHub repo
#   3. Set the "Root Directory" to: frontend
#   4. Framework preset: Next.js (auto-detected)
#   5. Add environment variable:
#      - NEXT_PUBLIC_STRAPI_URL = https://your-app-name.onrender.com
#   6. Click Deploy
#
# Free tier: Unlimited personal projects, custom domain support
# Your app will be live at: https://your-project.vercel.app
# -----------------------------------------------
# AI QUESTION OF THE DAY (Optional)
# -----------------------------------------------
# Google Gemini API Key (from Google AI Studio):
# GEMINI_API_KEY=AIzaSy...
#
# Alternatively, xAI / Grok API Key (from console.x.ai):
# XAI_API_KEY=xai-...
#
# Free fallback questions will automatically be used if neither key is configured.
